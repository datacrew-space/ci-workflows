{
  "env": { "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250k" },
  "hooks": {
    "PreCompact": [
      { "hooks": [ { "type": "command", "shell": "bash", "command": "cat \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/compact-instructions.md\"" } ] }
    ],
    "SessionStart": [
      { "matcher": "compact", "hooks": [ { "type": "command", "shell": "bash", "command": "cat \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/after-compact.md\"" } ] }
    ]
  }
}
