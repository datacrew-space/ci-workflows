{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I .claude/hooks/session_start_issues.py" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I .claude/hooks/require_issue_link.py" }
        ]
      }
    ]
  }
}
